{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".venv-local/**",
      "backend/**",
      ".venv/**",
      "Dockerfile",
      ".dockerignore",
      "README.md",
      "firestore.rules",
      "*.sql",
      "**/*.sql",
      "*.log",
      "**/*.log",
      "marketplace.sqlite3",
      "marketplace.sqlite3-*"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "adistu-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}